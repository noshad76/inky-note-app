{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inky",
  "version": "0.1.0",
  "identifier": "com.tauri.notes",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Inkey Notes",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Persian"
        ]
      }
    },
    "android": {
      "autoIncrementVersionCode": true,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}